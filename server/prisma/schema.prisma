generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CropStatus {
  ACTIVE
  COMPLETED
}

enum PaymentMode {
  CASH
  UPI
  BANK
  CARD
}

enum StockCategory {
  FEED
  MEDICINE
  SEED
}

model User {
  id       String  @id @default(cuid())
  fullName String
  mobile   String  @unique
  email    String? @unique
  password String

  farms Farm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Farm {
  id        String @id @default(cuid())
  farmName  String
  ownerName String

  location   String?
  district   String?
  state      String?
  totalAcres Float?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sites     Site[]
  stockings Stocking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id String @id @default(cuid())

  siteName String
  location String
  area     Float?

  district String?
  state    String?

  gpsLocation String?
  remarks     String?

  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  tanks            Tank[]
  stockings        Stocking[]
  stockAllocations SiteStockAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stocking {
  id String @id @default(cuid())

  category StockCategory

  totalQuantity Float

  unit String @default("kg")

  costPerKg Float?

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  allocations SiteStockAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteStockAllocation {
  id String @id @default(cuid())

  allocatedQuantity Float

  unit String @default("kg")

  stockingId String
  stocking   Stocking @relation(fields: [stockingId], references: [id], onDelete: Cascade)

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tank {
  id          String  @id @default(cuid())
  tankName    String
  area        Float
  depth       Float
  waterSource String
  gpsLocation String?
  remarks     String?

  hatcheryName String?
  hatcheryUnit String?

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  crops      Crop[]
  medicines  Medicine[]
  pondLeases PondLease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Crop {
  id String @id @default(cuid())

  cropName String?

  seedQuantity Float?

  seedVariety String

  batchNumber String?

  plCount Int?

  stockingDate DateTime

  expectedHarvestDate DateTime?

  cropDuration Int?

  expectedProduction   Float?
  expectedSellingPrice Float?

  notes String?

  status CropStatus @default(ACTIVE)

  tankId String
  tank   Tank   @relation(fields: [tankId], references: [id], onDelete: Cascade)

  feedEntries FeedEntry[]
  expenses    Expense[]
  harvests    Harvest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeedEntry {
  id String @id @default(cuid())

  date DateTime

  feedType  String
  feedBrand String
  feedSize  String

  quantity Float

  costPerKg Float

  totalCost Float

  notes String?

  cropId String
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Expense {
  id String @id @default(cuid())

  category    String
  description String

  amount Float

  paymentMode PaymentMode

  receipt String?
  notes   String?

  date DateTime

  cropId String
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Medicine {
  id String @id @default(cuid())

  date DateTime

  medicineName String
  purpose      String
  dosage       String
  quantity     Float
  cost         Float

  notes String?

  tankId String
  tank   Tank   @relation(fields: [tankId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum HarvestType {
  INTERMEDIATE
  FINAL
}

model Harvest {
  id String @id @default(cuid())

  harvestDate DateTime

  harvestWeight Float @default(0)

  harvestType HarvestType @default(INTERMEDIATE)

  harvestNumber Int @default(1)

  production Float?

  shrimpCount Float?

  averageWeight Float?

  survivalRate Float

  sellingPrice Float

  buyerName String

  transportationCost Float?

  harvestExpense Float

  revenue Float

  profit Float

  notes String?

  cropId String
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  mobile    String
  otpHash   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([mobile])
}

model PondLease {
  id               String   @id @default(cuid())
  totalLeaseAmount Float
  leaseStartDate   DateTime
  leaseEndDate     DateTime
  remarks          String?

  tankId String
  tank   Tank   @relation(fields: [tankId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}